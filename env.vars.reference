# Справочник переменных окружения для Control API (не является обязательным «.env» в проде).
#
# Production (k3s): только локальные копии из *.example.yaml (см. .gitignore):
# api-secret.yaml, control-infra-secrets.yaml, keycloak-secrets.yaml, rosout-bridge-secret.yaml.
#
# Локально: docker-compose.dev.yml подставляет разумные значения сам; этот файл можно
# использовать как шпаргалку или передать переменные через `export` перед `docker compose`.

# PostgreSQL (совпадает с compose по умолчанию)
POSTGRES_DB=wolfpack_control
POSTGRES_USER=wolfpack_control
POSTGRES_PASSWORD=wolfpack_control

# Control API (async URL для FastAPI)
DATABASE_URL=postgresql+asyncpg://wolfpack_control:wolfpack_control@postgres:5432/wolfpack_control

# Keycloak OIDC (отдельный поддомен, HTTPS 443)
KEYCLOAK_ISSUER=https://auth.wolfpack.robotics-rtuitlab.ru/realms/wolfpack-control
KEYCLOAK_JWKS_URL=https://auth.wolfpack.robotics-rtuitlab.ru/realms/wolfpack-control/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=wolfpack-control-web
# Опционально: операторы Control как admin по логину/email (если роль в KC не пробрасывается в токен)
# CONTROL_ADMIN_USERNAMES=wolfpack-operator,ops@example.com

# Kubernetes API (в pod — in-cluster; локально при необходимости kubeconfig на хосте)
K8S_NAMESPACE=wolfpackcloud-zenoh
# Значения wolfpack.io/role через запятую — worker и dev в одном пуле UI (master не показывается)
K8S_RESOURCE_POOL_ROLE_VALUES=worker,dev
# Не показывать control-plane ноды (по умолчанию true): K8S_HIDE_CONTROL_PLANE_NODES=true
# Исключить wolfpack.io/role из UI: K8S_ORCHESTRATION_EXCLUDE_ROLE_VALUES=master
# Доп. попадание в пул по label (если нет wolfpack.io/role из пула):
# K8S_POOL_OPTIONAL_LABEL_KEY=wolfpack.io/node-class
# K8S_POOL_OPTIONAL_LABEL_VALUE=dev

# Образы peer
COMPUTE_PEER_IMAGE_AMD64=10.43.50.10:5000/wolfpackcloud-compute-instance-peer:humble-amd64
COMPUTE_PEER_IMAGE_ARM64=10.43.50.10:5000/wolfpackcloud-compute-instance-peer:humble-arm64

# ROS log ingest (общий секрет с rosout-bridge)
ROSOUT_INGEST_TOKEN=change-me-ingest-token-min-32-chars

APP_NAME=WolfpackCloud Control API
API_BASE_URL=https://wolfpack.robotics-rtuitlab.ru/api
DEBUG=false
PAIR_CODE_EXPIRATION_MINUTES=15

# docker-compose (опционально переопределить порты)
API_PORT=9200
CLIENT_PORT=9201
