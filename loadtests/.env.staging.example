# Staging load test defaults (без секретов). Скопируйте в .env.staging и заполните при необходимости.
STAGING_BASE_URL=https://staging.wolfpack.robotics-rtuitlab.ru
KEYCLOAK_ISSUER=https://auth.wolfpack.robotics-rtuitlab.ru/realms/wolfpack-control-staging
KEYCLOAK_CLIENT_ID=wolfpack-control-web
# KEYCLOAK_USERNAME=loadtest-admin
# KEYCLOAK_PASSWORD=...
# Port-forward вместо Ingress:
# STAGING_BASE_URL=http://127.0.0.1:18081
