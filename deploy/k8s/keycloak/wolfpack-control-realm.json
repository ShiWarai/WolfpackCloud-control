{
  "realm": "wolfpack-control",
  "enabled": true,
  "displayName": "WolfpackCloud Control",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {"name": "user", "description": "Обычный пользователь WolfpackCloud Control"},
      {"name": "admin", "description": "Оркестрация и администрирование workloads"}
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "wolfpack-control-web",
      "name": "WolfpackCloud Control SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "https://wolfpack.robotics-rtuitlab.ru/*",
        "http://localhost:9200/*",
        "http://127.0.0.1:9200/*",
        "https://oauth.pstmn.io/v1/callback",
        "https://oauth.pstmn.io/*"
      ],
      "webOrigins": [
        "https://wolfpack.robotics-rtuitlab.ru",
        "https://auth.wolfpack.robotics-rtuitlab.ru",
        "https://oauth.pstmn.io"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true
    },
    {
      "clientId": "wolfpack-control-api",
      "name": "Control API (audience / документация)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": true
    },
    {
      "clientId": "wolfpack-data-lake-admin",
      "name": "WolfpackCloud Data Lake Admin UI",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://data-lake.robotics-rtuitlab.ru/oauth2/callback"
      ],
      "webOrigins": [
        "https://data-lake.robotics-rtuitlab.ru"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://data-lake.robotics-rtuitlab.ru/oauth2/sign_in"
      },
      "fullScopeAllowed": true
    }
  ]
}
